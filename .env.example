# Example environment file for ZYRA / FRIDAY Windows Desktop AI Assistant
# Copy this file to .env and fill in your keys if you want to use cloud AI services.
# ZYRA works 100% locally and offline without any API keys!

# Google Gemini API Key (Free tier available at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional, https://platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here

# Local Ollama Server URL (Optional, default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Assistant Configuration
ASSISTANT_NAME=FRIDAY
USER_TITLE=sir
VOICE_GENDER=female
TTS_ENABLED=true
BROWSER_BRIDGE_PORT=5005
