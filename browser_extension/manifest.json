{
  "manifest_version": 3,
  "name": "ZYRA / FRIDAY Desktop Assistant Bridge",
  "version": "1.0.0",
  "description": "Enables deep browser tab control, tab listing, and history search for ZYRA/FRIDAY Windows Assistant.",
  "permissions": [
    "tabs",
    "history",
    "bookmarks"
  ],
  "host_permissions": [
    "http://127.0.0.1:5005/*",
    "http://localhost:5005/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ZYRA Assistant Bridge"
  }
}
